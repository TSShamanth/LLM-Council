{
  "name": "council-of-llms",
  "version": "2.0.0",
  "description": "Blind peer review system for LLM outputs - Production Ready",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node server.js",
    "dev:client": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server.js",
    "test": "vitest",
    "lint": "eslint src",
    "format": "prettier --write src"
  },
  "configNotes": {
    "server": "Install these separately: npm install express cors helmet dotenv express-rate-limit express-validator",
    "optional": "For production monitoring and error tracking"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.6.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-rate-limit": "^7.2.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "terser": "^5.46.0",
    "vite": "^7.3.1",
    "vitest": "^1.5.0"
  },
  "optionalDependencies": {
    "@sentry/node": "^7.108.0",
    "joi": "^17.12.2",
    "redis": "^4.6.13"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
