# ════════════════════════════════════════════════════════════════════════════════
# Council of LLMs — Environment Variables
# ════════════════════════════════════════════════════════════════════════════════
# 
# SECURITY WARNING:
# - NEVER commit this file with real values to Git
# - NEVER expose API keys in client-side code
# - All keys must ONLY be used in server.js (backend)
#
# Setup:
# 1. Copy this file to .env:  cp .env.example .env
# 2. Fill in your real API keys below
# 3. Add .env to .gitignore:  echo ".env" >> .gitignore
#
# ════════════════════════════════════════════════════════════════════════════════

# ── SERVER CONFIGURATION ────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ── API KEYS (REQUIRED) ─────────────────────────────────────────────────────────
# Get these from the respective provider dashboards:

# Google AI Studio: https://makersuite.google.com/app/apikey
GOOGLE_AI_API_KEY=AIzaSyBvgmqOX5t8oiSwf6n7xEjwtLWpieHxkmM

# Groq: https://console.groq.com/keys
GROQ_API_KEY=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

# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=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

# ── MODEL CONFIGURATION (OPTIONAL) ──────────────────────────────────────────────
# Override default models if needed

GOOGLE_AI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_MODEL=qwen/qwen3.5-plus-02-15

# ── SECURITY (OPTIONAL) ─────────────────────────────────────────────────────────
# Rate limiting: requests per minute per IP (default: 20)
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000

# Maximum prompt length in characters (default: 5000)
MAX_PROMPT_LENGTH=5000

# ── MONITORING (OPTIONAL) ───────────────────────────────────────────────────────
# For production error tracking

# Sentry: https://sentry.io
SENTRY_DSN=

# Redis for caching (optional, speeds up repeated prompts)
REDIS_URL=redis://localhost:6379

# ── PRODUCTION ONLY ─────────────────────────────────────────────────────────────
# Only needed when deploying to production

# Database connection string (if storing results)
DATABASE_URL=

# Session secret for authentication
SESSION_SECRET=

# ════════════════════════════════════════════════════════════════════════════════
# CHECKLIST BEFORE RUNNING:
# ════════════════════════════════════════════════════════════════════════════════
# ✅ All API keys filled in above
# ✅ .env added to .gitignore
# ✅ npm install express cors helmet dotenv express-rate-limit express-validator
# ✅ Test: node server.js (should start without errors)
# ✅ Test: npm run dev (should start both server and client)
# ════════════════════════════════════════════════════════════════════════════════
