# ════════════════════════════════════════════════════════════════════════════════
# Council of LLMs — Environment Variables (TEMPLATE)
# ════════════════════════════════════════════════════════════════════════════════
# 
# SECURITY WARNING:
# - NEVER commit your real .env file to Git
# - Fill in placeholders below for reference only
#
# Setup:
# 1. Copy this file to .env:  cp .env.example .env
# 2. Fill in your REAL API keys in the .env file
# ════════════════════════════════════════════════════════════════════════════════

PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# API KEYS (Get these from provider dashboards)
GOOGLE_AI_API_KEY=your-google-key-here
GROQ_API_KEY=your-groq-key-here
OPENROUTER_API_KEY=your-openrouter-key-here

# MODEL CONFIGURATION
GOOGLE_AI_MODEL=gemini-1.5-flash
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct
